# ── 运行时依赖 ──
node_modules/
frontend/node_modules/

# ── Python 运行时 ──
__pycache__/
*.pyc
*.pyo
backend/cache/
backend/build/
backend/vendor/
backend/*.log

# ── 构建输出 ──
release/
frontend/dist/
electron/dist-backend/

# ── 临时文件 ──
*.log
frontend/err.txt
frontend/public/bg.png

# ── 打包产物 ──
*.asar
*.exe
*.msi
*.dmg

# ── 系统文件 ──
.DS_Store
Thumbs.db
desktop.ini

# ── 背景图：仅上传默认三张，用户添加的自定义图片不上传 ──
frontend/public/bg/**
!frontend/public/bg/main/
frontend/public/bg/main/**
!frontend/public/bg/main/bg-main.png
!frontend/public/bg/sidebar/
frontend/public/bg/sidebar/**
!frontend/public/bg/sidebar/bg-sidebar.png
!frontend/public/bg/player/
frontend/public/bg/player/**
!frontend/public/bg/player/bg-player.png

# ── 本地配置（含个人路径，不入库，参考 config.example.json）──
backend/config.json

# ── 环境变量 / 密钥 ──
.env
.env.local
*.secret

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo

# ── 本地调试产物 ──
desktop.log
.launch-test.txt

